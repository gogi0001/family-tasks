!android/gradle/wrapper/gradle-wrapper.properties

# APK/AAB — не в гит, публикуем отдельно
*.apk
*.aab
*.ap_
*.dex

# Keystore — НИКОГДА в гит
*.jks
*.keystore
keystore.properties

